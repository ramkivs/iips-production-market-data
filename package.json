  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "react-router-dom": "^6.30.6"
  },
  "exports": {
    "./portfolio-ui": {
      "types": "./dist/package/src/ui/portfolio_ui_package.d.ts",
