  "description": "Institutional Investment Platform System (IIPS) - Production Market Data & Intelligence Pipeline",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build && npm run build:portfolio-ui-package",
    "build:tsc": "tsc",
    "build:vite": "vite build",
    "build:portfolio-ui-package": "tsc -p tsconfig.portfolio-ui-package.json",
    "dev": "vite",
    "test": "node scripts/run-tests.mjs",
    "test:direct": "node --test --experimental-strip-types tests/*.test.ts",
    "prepack": "npm run build:portfolio-ui-package",
    "prepare": "npm run build:portfolio-ui-package"
  },
  "keywords": [
    "iips",
    "market-data",
    "canonical-contracts",
    "security-master",
    "data-quality",
    "point-in-time"
  ],
