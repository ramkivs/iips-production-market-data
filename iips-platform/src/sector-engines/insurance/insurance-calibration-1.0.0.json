{
  "$schema": "https://iips-engineering-standards/calibration-profile.schema.json#1.0.0",
  "profileId": "insurance-calibration",
  "version": "1.0.0",
  "engineId": "sector.insurance",
  "sectorFamily": "Insurance",
  "immutable": true,
  "publishedAt": "2026-08-06T00:00:00.000Z",
  "metricThresholds": [
    {
      "metricId": "IM-001",
      "name": "Combined Ratio",
      "unit": "%",
      "bands": [
        { "label": "Elite", "min": null, "max": 90 },
        { "label": "Strong", "min": 90, "max": 95 },
        { "label": "Adequate", "min": 95, "max": 100 },
        { "label": "Weak", "min": 100, "max": 105 },
        { "label": "Critical", "min": 105, "max": null }
      ]
    },
    {
      "metricId": "IM-002",
      "name": "Solvency Ratio",
      "unit": "x",
      "bands": [
        { "label": "Strong", "min": 2.0, "max": null },
        { "label": "Good", "min": 1.5, "max": 2.0 },
        { "label": "Adequate", "min": 1.25, "max": 1.5 },
        { "label": "Weak", "min": null, "max": 1.25 }
      ]
    },
    {
      "metricId": "IM-005",
      "name": "Persistency Ratio",
      "unit": "%",
      "bands": [
        { "label": "Strong", "min": 90, "max": null },
        { "label": "Good", "min": 80, "max": 90 },
        { "label": "Adequate", "min": 70, "max": 80 },
        { "label": "Weak", "min": null, "max": 70 }
      ]
    }
  ],
  "scoreWeights": [
    { "scoreId": "underwriting", "weight": 0.30 },
    { "scoreId": "solvency", "weight": 0.20 },
    { "scoreId": "growth", "weight": 0.20 },
    { "scoreId": "persistency", "weight": 0.15 },
    { "scoreId": "profitability", "weight": 0.15 }
  ],
  "penaltyRules": [
    { "rule": "critical-combined-ratio", "description": "Combined ratio > 105% caps composite at 60", "weight": 0.1 },
    { "rule": "solvency-breach", "description": "Solvency below regulatory minimum blocks Strong Buy", "weight": 0.2 }
  ],
  "verdictMapping": [
    { "minScore": 80, "maxScore": 100, "verdict": "Strong Buy" },
    { "minScore": 70, "maxScore": 80, "verdict": "Buy" },
    { "minScore": 60, "maxScore": 70, "verdict": "Accumulate" },
    { "minScore": 50, "maxScore": 60, "verdict": "Hold" },
    { "minScore": 40, "maxScore": 50, "verdict": "Watch" },
    { "minScore": 0, "maxScore": 40, "verdict": "Avoid" }
  ],
  "confidenceRules": {
    "dataCompleteness": 0.9,
    "dataQuality": 0.9,
    "metricConsistency": 0.8,
    "calibrationStability": 1.0,
    "governanceChecks": 1.0
  },
  "overrideRules": [
    { "rule": "solvency-breach", "description": "Solvency breach caps recommendation at Watch" },
    { "rule": "critical-combined-ratio", "description": "Combined ratio > 105% caps recommendation at Watch" },
    { "rule": "governance-failure", "description": "Severe governance failure caps recommendation at Avoid" },
    { "rule": "catastrophic-claims", "description": "Catastrophic claims (P&C) reduce recommendation" },
    { "rule": "persistency-deterioration", "description": "Persistency deterioration reduces recommendation" }
  ]
}
